#!/usr/bin/env python3

import subprocess

# Define the path to your configuration file
config_file_path = '/Users/liebl/.config/aerospace/aerospace.toml'


def toggle_outer_top():
    # Values to toggle between
    default_value = 20
    toggle_value = 50

    # Read the configuration file
    with open(config_file_path, 'r') as file:
        lines = file.readlines()

    # Modify the outer.top value
    for i, line in enumerate(lines):
        if 'outer.top' in line:
            current_value = int(line.split('=')[1].strip())
            new_value = toggle_value if current_value == default_value else default_value
            lines[i] = f"outer.top =        {new_value}\n"
            break  # Assuming only one outer.top entry

    # Write the updated configuration back to the file
    with open(config_file_path, 'w') as file:
        file.writelines(lines)

    # Reload the AeroSpace configuration
    try:
        subprocess.run(['aerospace', 'reload-config'], check=True)
        print("Configuration updated and reloaded successfully.")
    except subprocess.CalledProcessError:
        print("Failed to reload AeroSpace configuration.")

if __name__ == '__main__':
    toggle_outer_top()
